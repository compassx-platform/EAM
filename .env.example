# ==============================================================================
# CompassX EAM - Environment Variables Configuration Template
# ==============================================================================

# PostgreSQL Connection Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eam_db

# Direct Database URL (Optional: takes precedence if provided)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/eam_db

# Security & Authentication
SECRET_KEY=compassx-workflow-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Background Worker Settings
EXPIRY_CHECK_INTERVAL_SECONDS=30
